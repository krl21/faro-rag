# Configuración del proyecto. Cópialo a .env (`cp .env.example .env` o `make env`) y ajusta lo que necesites. Nunca subas .env al repositorio: puede tener claves.

# --- General ---
# Nivel mínimo de los logs. INFO: una línea por paso (ids, contadores, tiempos);
# DEBUG: además el contenido completo (preguntas, texto de documentos, respuestas del LLM).
# Valores: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Orígenes a los que el navegador permite llamar a la API (CORS). Lista JSON.
CORS_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL ---
# Usuario, contraseña y nombre de la base de datos de la aplicación.
POSTGRES_USER=faro
POSTGRES_PASSWORD=faro
POSTGRES_DB=faro
# Puerto del equipo por el que un cliente local (DBeaver, psql) llega a Postgres.
POSTGRES_HOST_PORT=5432

# --- Límites de subida ---
# Tamaño máximo de un PDF subido, en MB. Un fichero mayor se rechaza con 413.
MAX_UPLOAD_MB=20
# Número máximo de páginas de un PDF. Uno con más páginas queda en failed (too_many_pages).
MAX_PAGES=200

# --- Ingesta ---
# Biblioteca que extrae el texto de cada página del PDF.
# Valores: pypdf (por defecto, ligera) | docling (solo en el worker; mejor con tablas y escaneos, más lenta).
PDF_EXTRACTOR=pypdf
# Tamaño de cada fragmento (chunk) de texto, en caracteres, para la búsqueda del chat.
CHUNK_SIZE=1000
# Caracteres que se solapan entre fragmentos consecutivos. Debe ser menor que CHUNK_SIZE.
CHUNK_OVERLAP=150

# --- LLM (modelo de lenguaje) ---
# Proveedor del LLM que clasifica documentos, extrae campos y responde en el chat.
# Valores: fake (falso, sin red ni coste; para demo y tests) | litellm (modelo real).
LLM_PROVIDER=fake
# Modelo que se usa con litellm, con el prefijo del proveedor (p. ej. gemini/gemini-2.5-flash, openai/gpt-4o-mini). Con LLM_DOCUMENT_INPUT=pdf debe aceptar PDF. Con fake se ignora.
LLM_MODEL=fake-llm
# Clave de la API del proveedor del LLM. Vacía con fake.
LLM_API_KEY=
# URL alternativa del proveedor (modelos propios o detrás de un proxy). Vacía para usar la oficial.
LLM_API_BASE=
# Tiempo máximo de cada llamada al LLM, en segundos. Si se supera, la tarea se reintenta.
LLM_TIMEOUT_SECONDS=20
# Creatividad de las respuestas del LLM. 0 = respuestas estables y repetibles. Valores: de 0 a 2.
LLM_TEMPERATURE=0

# --- Embeddings ---
# Proveedor que convierte el texto en vectores.
# Valores: sentence_transformers (local, sin coste, por defecto) | litellm (API externa) | fake (tests).
EMBEDDING_PROVIDER=sentence_transformers
# Modelo de embeddings.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Longitud de cada vector. Debe coincidir con el modelo.
EMBEDDING_DIM=384
# Clave de la API del proveedor de embeddings. Solo con litellm.
EMBEDDING_API_KEY=
# URL alternativa del proveedor de embeddings. Solo con litellm; vacía para usar la oficial.
EMBEDDING_API_BASE=
# Tiempo máximo de cada llamada de embeddings remota, en segundos.
EMBEDDING_TIMEOUT_SECONDS=10
# Fragmentos que se envían en cada llamada de embeddings. Más alto = menos llamadas, pero más memoria.
EMBEDDING_BATCH_SIZE=32

# --- Extracción de campos ---
# Segundos de espera antes de cada reintento cuando el LLM devuelve una respuesta inválida.
EXTRACTION_RETRY_DELAYS=[2,6]
# Qué recibe el LLM al clasificar y al extraer campos.
# Valores: pdf (el PDF original adjunto; el modelo debe aceptar PDF) | text (el texto extraído, para modelos solo de texto).
LLM_DOCUMENT_INPUT=pdf
# Solo con LLM_DOCUMENT_INPUT=text: caracteres del principio del documento que se envían para clasificarlo. La extracción de campos recibe siempre el documento entero.
CLASSIFICATION_MAX_CHARS=12000

# --- Búsqueda desde el chat ---
# Fragmentos que se pasan como máximo al LLM para responder una pregunta.
RETRIEVAL_TOP_K=6
# Candidatos que trae cada búsqueda (vectorial y por texto) antes de combinarlas.
RETRIEVAL_CANDIDATES=20
# Similitud mínima para que un fragmento cuente como evidencia en la búsqueda vectorial.
# Más alto = más estricto (más "no hay información suficiente"). Valores: de 0 a 1.
RETRIEVAL_MIN_SIMILARITY=0.35
# Constante con la que se combinan los rankings de las dos búsquedas (Reciprocal Rank Fusion).
RETRIEVAL_RRF_K=60

# --- Chat ---
# Zona horaria con la que se interpretan "hoy", "ayer", "la semana pasada"... en las preguntas.
TIMEZONE=America/Toronto
# Intercambios anteriores (pregunta + respuesta) que se dan al LLM como contexto para entender referencias como "¿y la de B?". Valores: de 0 (sin contexto) a 10.
CHAT_CONTEXT_TURNS=3
# Número máximo de documentos que devuelve el chat cuando la pregunta solo pide listarlos. Valores: de 1 a 500.
CHAT_LIST_LIMIT=50

# --- Reintentos de la tarea de procesamiento ---
# Veces que se reintenta procesar un documento si falla el proveedor o la base de datos.
TASK_MAX_RETRIES=3
# Espera inicial entre reintentos, en segundos; se duplica en cada intento.
TASK_RETRY_BACKOFF_SECONDS=5
# Espera máxima entre reintentos, en segundos.
TASK_RETRY_BACKOFF_MAX_SECONDS=60

# --- Límite de peticiones ---
# Preguntas al chat permitidas por IP (en /ask y /documents/{id}/ask). 
# Formato: número/unidad. Unidades: second | minute | hour | day.
ASK_RATE_LIMIT=10/minute

# --- Trazas ---
# Envía las trazas de la API y el worker a Jaeger. Valores: true | false.
OTEL_ENABLED=true
