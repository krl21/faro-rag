# Project configuration. Copy it to .env (`cp .env.example .env` or `make env`) and adjust what you need. Never commit .env: it may contain keys.

# --- General ---
# Minimum log level. INFO: one line per step (ids, counters, timings);
# DEBUG: also the full content (questions, document text, LLM answers).
# Values: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Origins the browser may call the API from (CORS). JSON list.
CORS_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL ---
# User, password and name of the application database.
POSTGRES_USER=faro
POSTGRES_PASSWORD=faro
POSTGRES_DB=faro
# Host port a local client (DBeaver, psql) uses to reach Postgres.
POSTGRES_HOST_PORT=5432

# --- Upload limits ---
# Maximum size of an uploaded PDF, in MB. A larger file is rejected with 413.
MAX_UPLOAD_MB=20
# Maximum number of pages of a PDF. One with more pages ends up failed (too_many_pages).
MAX_PAGES=200

# --- Ingestion ---
# The text of each PDF page is extracted with Docling (worker only: tables, layout and OCR).
# The first document downloads its models into the cache; each worker process loads its own copy.
# Size of each text fragment (chunk), in characters, for the chat search.
CHUNK_SIZE=1000
# Characters shared by consecutive fragments. Must be smaller than CHUNK_SIZE.
CHUNK_OVERLAP=150

# --- LLM (chat) ---
# LLM provider that classifies documents, extracts fields and answers in the chat.
# Values: fake (no network, no cost; for demo and tests) | litellm (real model).
LLM_PROVIDER=fake
# Model used with litellm, with the provider prefix (e.g. gemini/gemini-2.5-flash, openai/gpt-4o-mini). With LLM_DOCUMENT_INPUT=pdf it must accept PDF. Ignored with fake.
LLM_MODEL=fake-llm
# API key of the LLM provider. Empty with fake.
LLM_API_KEY=
# Alternative provider URL (self-hosted models or behind a proxy). Empty to use the official one.
LLM_API_BASE=
# Maximum time of each LLM call, in seconds. If exceeded, the task is retried.
LLM_TIMEOUT_SECONDS=20
# Creativity of the LLM answers. 0 = stable, repeatable answers. Values: 0 to 2.
LLM_TEMPERATURE=0

# --- Embeddings ---
# Provider that turns text into vectors.
# Values: sentence_transformers (local, no cost, default) | litellm (external API) | fake (tests).
EMBEDDING_PROVIDER=sentence_transformers
# Embedding model.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Length of each vector. Must match the model.
EMBEDDING_DIM=384
# API key of the embedding provider. Only with litellm.
EMBEDDING_API_KEY=
# Alternative URL of the embedding provider. Only with litellm; empty to use the official one.
EMBEDDING_API_BASE=
# Maximum time of each remote embedding call, in seconds.
EMBEDDING_TIMEOUT_SECONDS=10
# Fragments sent in each embedding call. Higher = fewer calls, but more memory.
EMBEDDING_BATCH_SIZE=32

# --- Structured extraction ---
# Seconds to wait before each retry when the LLM returns an invalid answer.
EXTRACTION_RETRY_DELAYS=[2,6]
# What the LLM receives when classifying and extracting fields.
# Values: pdf (the original PDF attached; the model must accept PDF) | text (the extracted text, for text-only models).
LLM_DOCUMENT_INPUT=pdf
# Only with LLM_DOCUMENT_INPUT=text: characters from the start of the document sent to classify it. Field extraction always receives the whole document.
CLASSIFICATION_MAX_CHARS=12000

# --- Retrieval (RAG) ---
# Maximum number of fragments passed to the LLM to answer a question.
RETRIEVAL_TOP_K=6
# Candidates each search (vector and text) returns before they are combined.
RETRIEVAL_CANDIDATES=20
# Minimum similarity for a fragment to count as evidence in the vector search.
# Higher = stricter (more "not enough information" answers). Values: 0 to 1.
RETRIEVAL_MIN_SIMILARITY=0.35
# Constant used to combine the rankings of both searches (Reciprocal Rank Fusion).
RETRIEVAL_RRF_K=60
# Questions about one document: label-value data of its tables and "campo: valor" lines
# passed to the LLM, the ones most related to the question. 0 = none. Values: 0 to 100.
RETRIEVAL_FACTS_TOP_K=15

# --- Chat ---
# Time zone used to interpret "today", "yesterday", "last week"... in questions.
TIMEZONE=America/Toronto
# Previous exchanges (question + answer) given to the LLM as context to resolve references such as "and the one for B?". Values: 0 (no context) to 10.
CHAT_CONTEXT_TURNS=3
# Maximum number of documents the chat returns when the question only asks to list them. Values: 1 to 500.
CHAT_LIST_LIMIT=50

# --- Worker ---
# Documents the worker processes at the same time (Celery child processes).
# Each process loads its own embedding and Docling models, so every extra one costs RAM. Values: 1 to 16.
WORKER_CONCURRENCY=2

# --- Celery task retries ---
# Times a document is processed again if the provider or the database fails.
TASK_MAX_RETRIES=3
# Initial wait between retries, in seconds; it doubles on every attempt.
TASK_RETRY_BACKOFF_SECONDS=5
# Maximum wait between retries, in seconds.
TASK_RETRY_BACKOFF_MAX_SECONDS=60

# --- Rate limiting ---
# Chat questions allowed per IP (on /ask and /documents/{id}/ask).
# Format: number/unit. Units: second | minute | hour | day.
ASK_RATE_LIMIT=10/minute

# --- OpenTelemetry ---
# Sends the API and worker traces to Jaeger. Values: true | false.
OTEL_ENABLED=true
